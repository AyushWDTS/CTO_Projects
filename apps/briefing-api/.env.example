APP_NAME=WDTS News Dashboard
APP_ENV=local
LOG_LEVEL=INFO

# Postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/news_intelligence

# Optional: Celery/scheduled orchestration later
REDIS_URL=redis://localhost:6379/0

# Frontend origin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_PUBLIC_BASE_URL=http://localhost:3000

ORCHESTRATION_DEFAULT_DRY_RUN=true
ORCHESTRATION_ENABLED=false

# AI — AWS Bedrock (SSO + application inference profile)
AI_PROVIDER=bedrock
AWS_REGION=ap-south-1
AWS_PROFILE=your-aws-profile
BEDROCK_MODEL_ID=arn:aws:bedrock:REGION:ACCOUNT:application-inference-profile/PROFILE_ID
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS_PER_EVENT=24000
AI_ESTIMATED_INPUT_COST_PER_1K_TOKENS=0
AI_ESTIMATED_OUTPUT_COST_PER_1K_TOKENS=0
