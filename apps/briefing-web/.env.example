# Briefing news API (browser-safe)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Executive REST BFF (server-only — never NEXT_PUBLIC_* for the key)
WDTS_EXECUTIVE_BASE_URL=http://localhost:8443
WDTS_EXECUTIVE_API_KEY=wdts_live_replace_me
# Optional: calendar query timezone (default Asia/Kolkata)
# WDTS_EXECUTIVE_TIMEZONE=Asia/Kolkata

# Optional: travel curation (server-only BFF pass before /cto Travel tab)
# WDTS_EXECUTIVE_TRAVEL_CURATION=bedrock
# WDTS_EXECUTIVE_TRAVEL_CURATION=heuristic
# AWS_REGION=ap-south-1
# AWS_PROFILE=AI-Automation-team
# BEDROCK_MODEL_ID=arn:aws:bedrock:...
